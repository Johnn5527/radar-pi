# Configuração do avisador de radares (sem segredos)
RADAR_DB_PATH=data/radares.sqlite
RADAR_RAW_DIR=data/raw
RADAR_GRAPH_PATH=data/osm/sp_city.graphml
RADAR_ALERTA_M=450
RADAR_HORIZONTE_M=700
RADAR_H3_RES=9
RADAR_VOZ=espeak-ng
RADAR_VOZ_DIR=logs/voz
RADAR_GPS_SIGMA_M=10
# --- tela do mapa (pygame/SDL) ---
RADAR_TELA=800x480
RADAR_FULLSCREEN=0
RADAR_FPS=20
RADAR_ZOOM_M_PX=1.5
RADAR_ROTACIONAR=1
RADAR_HORIZONTE_PLACA_M=2000
RADAR_GPS=sim
RADAR_GPSD_HOST=127.0.0.1
RADAR_GPSD_PORT=2947
# --- v2 ---
RADAR_GRAPH_TILES=data/osm/malha_sp.sqlite
RADAR_VEICULO=leve
RADAR_ALERTA_HIST_M=30
RADAR_ALERTA_SEGURA_S=3
# --- voz: Piper TTS (pip install piper-tts; voz: python -m piper.download_voices pt_BR-faber-medium --data-dir data/vozes)
RADAR_TTS=piper
RADAR_PIPER_VOZ=data/vozes/pt_BR-faber-medium.onnx
RADAR_PIPER_LENGTH_SCALE=0.9
RADAR_VOZ_CACHE=data/voz_cache
# --- validação OSM + telemetria local (LGPD: só agregados por ponto, sem trajeto) ---
RADAR_OSM_RADARES=data/raw/osm/radares_osm.json
RADAR_TELEMETRIA=1
RADAR_TELEMETRIA_DB=data/telemetria.sqlite
RADAR_TELEMETRIA_K_MIN=5
